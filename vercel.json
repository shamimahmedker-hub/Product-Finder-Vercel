{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "^/robots\\.txt$",
      "dest": "/public/robots.txt"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/public/sitemap.xml"
    },
    {
      "src": "^/google[^/]*\\.html$",
      "dest": "$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
